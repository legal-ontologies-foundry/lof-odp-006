@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix lof: <https://w3id.org/lof/> .

<https://w3id.org/lof/odp-006.owl> a owl:Ontology ;
  owl:versionIRI <https://w3id.org/lof/odp-006/releases/0.1.0/odp-006.owl> ;
  owl:versionInfo "0.1.0" ;
  dcterms:title "LOF-ODP-006: Relations between Norms"@en ;
  dcterms:description "DRAFT for review by the LOF founding coordinators. An ontology design pattern for how items of legal content bear on one another: particularization, derogation (substitutive or blocking), conflict between the legal positions they ground, and the determinations, on grounds such as rank, specificity, time, or the primacy of European Union law, that one prevails over another, distinguishing determinations that have legal force from readings that do not."@en ;
  dcterms:creator "David R. Koepsell" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  owl:imports <https://w3id.org/lof/odp-006/imports/bfo_import.owl> ,
    <https://w3id.org/lof/odp-006/imports/odp-001_import.owl> ,
    <https://w3id.org/lof/odp-006/imports/odp-003_import.owl> .


dcterms:coverage a owl:AnnotationProperty .


##### Classes #####

lof:ODP006_0001000 a owl:Class ;
  rdfs:label "priority principle"@en ;
  skos:definition "A generically dependent continuant that states, on some ground such as rank, specificity, or time, which of two conflicting items of legal content prevails."@en ;
  rdfs:comment "Not a subclass of legal content: lex specialis and lex posterior are enacted in some legal systems and doctrinal in others. Where a priority principle is enacted, assert it to be legal content as well (LOF-P-010). The classical principles, and the primacy of European Union law, are provided as individuals."@en ;
  rdfs:subClassOf obo:BFO_0000031 .

lof:ODP006_0001001 a owl:Class ;
  rdfs:label "precedence determination"@en ;
  skos:definition "A generically dependent continuant that states that one item of legal content prevails over another where they conflict."@en ;
  rdfs:comment "Reifies the three-place fact that A prevails over B on ground P, as stated by some source. It is a generically dependent continuant for the reason legal content is (LOF-ODP-001): the same determination can be borne by a judgment, a commentary, and a database record; the act of determining is a process, and the determination is what that process yields. A determination has legal force only if it is also legal content, for example the holding of a court or a conflict rule in a statute; it is then an authoritative precedence determination. Guidance, scholarship, and an annotator's own reading are determinations without legal force."@en ;
  rdfs:subClassOf obo:BFO_0000031 ,
    [ a owl:Restriction ; owl:onProperty lof:ODP006_0001106 ; owl:someValuesFrom lof:ODP001_0001001 ] ,
    [ a owl:Restriction ; owl:onProperty lof:ODP006_0001107 ; owl:someValuesFrom lof:ODP001_0001001 ] .

lof:ODP006_0001002 a owl:Class ;
  rdfs:label "authoritative precedence determination"@en ;
  skos:definition "A precedence determination that is itself legal content."@en ;
  rdfs:comment "Recognized by inference: assert that a determination is legal content and it is classified here, and what it favours is then found to prevail over what it disfavours. The equivalence to 'authoritative self-link some Self' is a technical device (rolification) that lets the reasoner carry the class into the authoritative relations."@en ;
  owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( lof:ODP006_0001001 lof:ODP001_0001001 ) ] ,
    [ a owl:Restriction ; owl:onProperty lof:ODP006_0001114 ; owl:hasSelf true ] .


##### Object properties #####

lof:ODP006_0001100 a owl:ObjectProperty ;
  rdfs:label "particularizes"@en ;
  skos:definition "A relation between two items of legal content in which the first makes the second more determinate for some cases, without displacing it."@en ;
  rdfs:comment "Named to avoid confusion with LOF-ODP-002 'specified by'. Example: BDSG section 26(2) particularizes GDPR Article 7 for consent in employment. Close match to LOMO (Legal Ontology for Modelling Obligations) lomo:specifies."@en ;
  rdfs:domain lof:ODP001_0001001 ; rdfs:range lof:ODP001_0001001 .

lof:ODP006_0001101 a owl:ObjectProperty ;
  rdfs:label "derogates from"@en ;
  skos:definition "A relation between two items of legal content in which the first displaces the second for the cases within its scope."@en ;
  rdfs:comment "Deliberately not a subproperty of 'held to prevail over'. A derogation is often authorized by the content it derogates from (GDPR Article 89(2) permits Member States to restrict Article 15 for research), and then the derogating content does not outrank the authorizing one: if they truly conflicted, the authorizing content would prevail. Record the authorization with LOF-ODP-001: the enactment of the derogating content is 'performed under' the authorizing content. The pattern does not represent the derogation's scope, which is type-level."@en ;
  rdfs:domain lof:ODP001_0001001 ; rdfs:range lof:ODP001_0001001 .

lof:ODP006_0001102 a owl:ObjectProperty ;
  rdfs:label "substitutes for"@en ;
  skos:definition "A relation between two items of legal content in which the first displaces the second for the cases within its scope and provides a different rule for them."@en ;
  rdfs:comment "What LOMO's documentation calls substitutive derogation (described there in prose, not as a property)."@en ;
  rdfs:subPropertyOf lof:ODP006_0001101 .

lof:ODP006_0001103 a owl:ObjectProperty ;
  rdfs:label "creates exception to"@en ;
  skos:definition "A relation between two items of legal content in which the first removes some cases from the scope of the second without providing a rule for them."@en ;
  rdfs:comment "What LOMO's documentation calls blocking derogation. Close to Akoma Ntoso exceptionOfScope."@en ;
  rdfs:subPropertyOf lof:ODP006_0001101 .

lof:ODP006_0001104 a owl:ObjectProperty , owl:SymmetricProperty ;
  rdfs:label "conflicts with"@en ;
  skos:definition "A symmetric relation between two legal positions such that compliance with both is impossible, or one permits what the other forbids."@en ;
  rdfs:comment "Asserted, not inferred: deciding that two positions conflict requires comparing the conduct each concerns, which is the action-type problem of LOF-ODP-003 open question 2. Typical cases: a duty to do and a duty to refrain from the same conduct held by one holder; a duty and a liberty to the contrary. Conflict between legal content is inferred from this relation."@en ;
  rdfs:domain lof:ODP003_0001000 ; rdfs:range lof:ODP003_0001000 .

lof:ODP006_0001105 a owl:ObjectProperty , owl:SymmetricProperty ;
  rdfs:label "content conflicts with"@en ;
  skos:definition "A symmetric relation between two items of legal content that ground conflicting legal positions."@en ;
  rdfs:comment "Inferred by the chain inverse(grounded in) o conflicts with o grounded in. A content may conflict with itself, which records an internal contradiction."@en ;
  rdfs:domain lof:ODP001_0001001 ; rdfs:range lof:ODP001_0001001 ;
  owl:propertyChainAxiom ( [ owl:inverseOf lof:ODP003_0001101 ] lof:ODP006_0001104 lof:ODP003_0001101 ) .

lof:ODP006_0001106 a owl:ObjectProperty ;
  rdfs:label "favours"@en ;
  skos:definition "A relation between a precedence determination and the legal content that it states prevails."@en ;
  rdfs:domain lof:ODP006_0001001 ; rdfs:range lof:ODP001_0001001 .

lof:ODP006_0001107 a owl:ObjectProperty ;
  rdfs:label "disfavours"@en ;
  skos:definition "A relation between a precedence determination and the legal content that it states yields."@en ;
  rdfs:domain lof:ODP006_0001001 ; rdfs:range lof:ODP001_0001001 .

lof:ODP006_0001108 a owl:ObjectProperty ;
  rdfs:label "on the ground of"@en ;
  skos:definition "A relation between a precedence determination and the priority principle it applies."@en ;
  rdfs:domain lof:ODP006_0001001 ; rdfs:range lof:ODP006_0001000 .

lof:ODP006_0001109 a owl:ObjectProperty ;
  rdfs:label "held to prevail over"@en ;
  skos:definition "A relation between two items of legal content such that some precedence determination, with or without legal force, states that where they conflict the first governs and the second yields."@en ;
  rdfs:comment "Inferred by the chain inverse(favours) o disfavours. It records a reading, not the law: guidance and scholarship produce it too. For what the law itself settles, use 'prevails over'. Not declared asymmetric or transitive: OWL 2 DL forbids asymmetry on a property defined by a chain, precedence is not transitive across different scopes, and sources disagree. Mutual holdings are reported by the SHACL shapes as contested."@en ;
  rdfs:domain lof:ODP001_0001001 ; rdfs:range lof:ODP001_0001001 ;
  owl:propertyChainAxiom ( [ owl:inverseOf lof:ODP006_0001106 ] lof:ODP006_0001107 ) .

lof:ODP006_0001110 a owl:ObjectProperty ;
  rdfs:label "stated in"@en ;
  skos:definition "A relation between a precedence determination and the legal content, or other information content, in which it is stated."@en ;
  rdfs:comment "Records whose determination it is: a conflict rule in the legislation itself, the holding of a court, guidance without legal force, or an annotator's note."@en ;
  rdfs:domain lof:ODP006_0001001 ; rdfs:range obo:BFO_0000031 .

lof:ODP006_0001111 a owl:ObjectProperty ;
  rdfs:label "authoritatively favours"@en ;
  skos:definition "A relation between an authoritative precedence determination and the legal content that it states prevails."@en ;
  rdfs:comment "Inferred, never asserted: by the chain authoritative self-link o favours. Not declared a subproperty of favours, which OWL 2 DL forbids for a property defined by a chain through it (the property hierarchy would not be regular); every pair it relates is related by favours anyway."@en ;
  owl:propertyChainAxiom ( lof:ODP006_0001114 lof:ODP006_0001106 ) .

lof:ODP006_0001112 a owl:ObjectProperty ;
  rdfs:label "authoritatively disfavours"@en ;
  skos:definition "A relation between an authoritative precedence determination and the legal content that it states yields."@en ;
  rdfs:comment "Inferred, never asserted: by the chain authoritative self-link o disfavours. Not declared a subproperty of disfavours, for the reason given under authoritatively favours."@en ;
  owl:propertyChainAxiom ( lof:ODP006_0001114 lof:ODP006_0001107 ) .

lof:ODP006_0001113 a owl:ObjectProperty ;
  rdfs:label "prevails over"@en ;
  skos:definition "A relation between two items of legal content such that a precedence determination with legal force states that where they conflict the first governs and the second yields."@en ;
  rdfs:comment "Inferred by the chain inverse(authoritatively favours) o authoritatively disfavours, so only determinations that are legal content produce it. What 'prevails' amounts to differs by ground and system: invalidity of the yielding content (lex superior within one legal order), its disapplication in the case (primacy of EU law, Case 106/77 Simmenthal), or neither (lex specialis); see open question 1. Not asymmetric, for the reasons given under 'held to prevail over': courts of two legal orders can each authoritatively hold the contrary (BVerfG, 2 BvR 859/15, PSPP, 5 May 2020)."@en ;
  rdfs:subPropertyOf lof:ODP006_0001109 ;
  rdfs:domain lof:ODP001_0001001 ; rdfs:range lof:ODP001_0001001 ;
  owl:propertyChainAxiom ( [ owl:inverseOf lof:ODP006_0001111 ] lof:ODP006_0001112 ) .

lof:ODP006_0001114 a owl:ObjectProperty ;
  rdfs:label "authoritative self-link"@en ;
  skos:definition "A technical relation that holds between an authoritative precedence determination and itself, and between nothing else."@en ;
  rdfs:comment "Never asserted. It exists so that the authoritative relations can be inferred from class membership (rolification); data and queries should use 'prevails over'."@en .


##### Individuals: priority principles #####

lof:ODP006_0001500 a owl:NamedIndividual , lof:ODP006_0001000 ;
  rdfs:label "lex superior"@en ;
  skos:definition "The priority principle that legal content of higher rank in a legal order prevails over legal content of lower rank in the same order."@en ;
  rdfs:comment "Constitutional over statutory provisions, statute over regulation. Its usual effect is that the lower content is invalid to the extent of the conflict. The relation between EU law and national law is a different principle: see primacy of European Union law."@en .

lof:ODP006_0001501 a owl:NamedIndividual , lof:ODP006_0001000 ;
  rdfs:label "lex specialis"@en ;
  skos:definition "The priority principle that legal content governing a narrower class of cases prevails over legal content governing a wider class that includes it."@en .

lof:ODP006_0001502 a owl:NamedIndividual , lof:ODP006_0001000 ;
  rdfs:label "lex posterior"@en ;
  skos:definition "The priority principle that legal content established later prevails over legal content of equal rank established earlier."@en ;
  rdfs:comment "'Later' is judged by the enactment that established the content (LOF-ODP-001), not by when it entered into force or applies (LOF-ODP-005), although some systems use the date of publication or entry into force; record the choice. Between treaties, compare Vienna Convention on the Law of Treaties Article 30."@en .

lof:ODP006_0001503 a owl:NamedIndividual , lof:ODP006_0001000 ;
  rdfs:label "primacy of European Union law"@en ;
  skos:definition "The priority principle that European Union law prevails over conflicting national law of the Member States."@en ;
  rdfs:comment "Case 6/64 Costa v ENEL; Case 106/77 Simmenthal. Its effect is that the national provision is set aside in the case, not that it is void, which distinguishes it from lex superior. Its limits are contested by some national constitutional courts. Other legal systems have principles of the same shape, such as federal preemption in the United States and UN Charter Article 103; add them as individuals with their own coverage."@en ;
  dcterms:coverage "European Union"@en .
